<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="axsync_purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.form.axsync.delivery</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='products']" position="after">
                <page string="Delivery Tracking" name="axsync_delivery" invisible="state not in ('purchase', 'done')">
                    <group>
                        <group>
                            <field name="axsync_delivery_status" widget="badge" decoration-info="axsync_delivery_status == 'pending'"
                                   decoration-warning="axsync_delivery_status == 'partial'"
                                   decoration-success="axsync_delivery_status == 'received'"/>
                            <field name="axsync_expected_date"/>
                            <field name="axsync_last_receipt_date"/>
                        </group>
                        <group>
                            <field name="axsync_delay_days"/>
                            <field name="axsync_is_overdue"/>
                            <field name="axsync_outstanding_qty"/>
                            <field name="axsync_received_pct" widget="progressbar"/>
                        </group>
                    </group>
                    <field name="axsync_delivery_line_ids" readonly="1">
                        <tree create="0" edit="0" delete="0" decoration-danger="is_overdue" decoration-success="status == 'received'">
                            <field name="product_id"/>
                            <field name="expected_day" string="Expected"/>
                            <field name="receipt_day" string="Received On"/>
                            <field name="ordered_qty"/>
                            <field name="received_qty"/>
                            <field name="remaining_qty"/>
                            <field name="status" string="Status" widget="badge" decoration-info="status == 'pending'"
                                   decoration-warning="status == 'partial'" decoration-success="status == 'received'"/>
                            <field name="delay_days" string="Delay"/>
                            <field name="is_overdue" column_invisible="True"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="axsync_purchase_order_tree" model="ir.ui.view">
        <field name="name">purchase.order.tree.axsync.delivery</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="axsync_delivery_status" string="Delivery" widget="badge" optional="show"
                       decoration-info="axsync_delivery_status == 'pending'"
                       decoration-warning="axsync_delivery_status == 'partial'"
                       decoration-success="axsync_delivery_status == 'received'"/>
                <field name="axsync_delay_days" string="Delay (Days)" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
